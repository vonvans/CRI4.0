{
  "rules": [
    {
      "name": "LocalWeb",
      "proto": "tcp",
      "in_ip": "127.0.0.1",
      "in_port": 8080,
      "out_ip": "127.0.0.1",
      "out_port": 8000,
      "interceptors": ["dumplogger"]
    },
    {
      "name": "ModbusServ",
      "proto": "modbus",
      "in_ip": "127.0.0.1",
      "in_port": 5022,
      "out_ip": "127.0.0.1",
      "out_port": 5020,
      "interceptors": ["modbus_logger"]
    },
    {
      "name": "UDP raw",
      "proto": "udp",
      "in_ip": "127.0.0.1",
      "in_port": 7000,
      "out_ip": "127.0.0.1",
      "out_port": 7001,
      "udp_timeout_sec": 500,
      "interceptors": ["dumplogger"]
    }
  ]
}
