{
  "device_type": "ValveActuator",
  "modbus_bind": "0.0.0.0:1503",
  "netstream_addr": "localhost:8082",
  "properties": {
    "rate_limit": 5.0,
    "dt": 0.05
  },
  "variables": {
    "target_pos": {
      "modbus": {
        "address": 200,
        "kind": "holding",
        "type": "uint16",
        "scale": 100.0,
        "max": 100.0
      }
    },
    "actual_pos": {
      "netstream_pub": "commands/valve/opening",
      "modbus": {
        "address": 201,
        "kind": "holding",
        "type": "uint16",
        "scale": 100.0
      }
    }
  }
}
